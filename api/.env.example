# Brewery Compass API — environment variables (placeholders only; the real
# values live in the Render dashboard for the brewery-api service).

# Required
MONGO_URI=
MONGO_DB_NAME=brewery_compass
CLIENT_URL=

# v9 — Happening Nearby (both optional; the events panel stays hidden
# until at least one is set)
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=

# v11 — Happening Nearby local layer. The iCal feeds (city / museum /
# library calendars) need no key. Eventbrite is optional: set the private
# token from your Eventbrite account to light up the curated Triangle
# organizer pulls (Brewgaloo, Trophy Brewing, …).
EVENTBRITE_TOKEN=

# v9 — Admin area (required for /admin to work; pick a long random string)
ADMIN_KEY=

# v9 — Optional contact-form email notifications. The form stores messages
# in the database regardless; email is a bonus that only happens when ALL
# of these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_TO=
